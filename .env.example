# ==========================================
# CodeNPixels SMTP & Serverless Mail Configuration
# Configure these in Netlify Dashboard: Site configuration > Environment variables
# ==========================================

# 1. SMTP Server Hostname
# Examples:
#   Gmail: smtp.gmail.com
#   Zoho Mail: smtp.zoho.in (or smtp.zoho.com)
#   SendGrid: smtp.sendgrid.net
#   Brevo (Sendinblue): smtp-relay.brevo.com
#   Hostinger: smtp.hostinger.com
#   Amazon SES: email-smtp.us-east-1.amazonaws.com
SMTP_HOST="smtp.gmail.com"

# 2. SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT="587"

# 3. Use SSL/TLS directly (set "true" for port 465, "false" for port 587)
SMTP_SECURE="false"

# 4. SMTP Authentication Username (your email address or API user)
SMTP_USER="contact@codenpixels.in"

# 5. SMTP Authentication Password / App Password
# For Gmail: Use a 16-character Google "App Password" (https://myaccount.google.com/apppasswords)
# For Zoho/SendGrid/SES: Use your Mail password or API Key
SMTP_PASS="your_16_digit_app_password_or_smtp_key"

# 6. Contact Notification Receiver Email (where leads are delivered)
CONTACT_RECEIVER_EMAIL="codenpixel.2022@gmail.com"

# 7. Sender Display Name
SMTP_FROM_NAME="CodeNPixels Digital Lead Gateway"

# 8. Automated Client Confirmation Auto-Reply ("true" or "false")
SMTP_SEND_AUTOREPLY="true"

